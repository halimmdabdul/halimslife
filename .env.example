# Find these values in Supabase Dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional: Google Search Console (server-side only)
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:your-domain.com
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Bing Webmaster Tools (server-side only)
BING_WEBMASTER_SITE_URL=https://your-domain.com/
BING_WEBMASTER_API_KEY=your-bing-webmaster-api-key
